# The human-only p(doom): people play Doom in the browser, and every game is recorded to the
# same Databricks Lakebase database as the full app. No bot or model players are reachable.
#
# Build from the repo root, with the engine CI artifact (pdoom-engine-shim) unpacked to engine-out/:
#   docker build -f Dockerfile.human -t pdoom-human .
FROM node:20-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV VITE_HUMAN_ONLY=true VITE_DEFAULT_ENGINE=wasm
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY backend/pyproject.toml ./backend/pyproject.toml
COPY backend/src ./backend/src
RUN pip install --no-cache-dir ./backend
COPY --from=web /web/dist /app/static
# websockets-doom.js/.wasm, doom1.wad (shareware, episode 1) and default.cfg. GPL-2.0: publish the
# matching source for anything you deploy.
COPY engine-out/ /app/static/doom/
RUN test -s /app/static/doom/websockets-doom.wasm && test -s /app/static/doom/doom1.wad

# PDOOM_TRUST_PROXY: the container sits behind the Azure ingress, which appends the caller's
# address to X-Forwarded-For. Do not set it when running anywhere without such a proxy.
ENV PDOOM_STATIC_DIR=/app/static \
    PDOOM_HUMAN_ONLY=true \
    PDOOM_TRUST_PROXY=true \
    PDOOM_SINK=lakebase \
    PORT=8000
RUN useradd --create-home app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=2)"
CMD ["uvicorn", "pdoom.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
