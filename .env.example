# Backend settings. Copy to backend/.env for local runs.

# Databricks authentication (service principal, OAuth M2M). The SDK reads these directly.
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Where telemetry and ai_decide run
PDOOM_WAREHOUSE_ID=
PDOOM_UC_CATALOG=workspace
PDOOM_UC_SCHEMA=pdoom

# Telemetry sink: memory (tests), jsonl (local files), sql (Databricks warehouse)
PDOOM_SINK=jsonl
PDOOM_JSONL_PATH=telemetry.jsonl

# Pinned onto every session row. Change it whenever a model or prompt changes.
PDOOM_MODEL_VERSION=dev

# Optional: a vision-capable serving endpoint for the vision_llm player
PDOOM_VISION_ENDPOINT=

# Optional: serve a built web app from this folder (set in the container image)
PDOOM_STATIC_DIR=
